{
  "info": {
    "name": "Native Life Plugin · E-commerce",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "E-commerce plugin v1.2.2. Flow: import the ZIP (installs it), enable it globally (admin), enable it for the business (owner), grant plugin.ecommerce.* permissions, then use the folders below. Folder 7 lists expected error responses; the status assertions only pass in the matching state."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "limited_access_token",
      "value": ""
    },
    {
      "key": "plugin_key",
      "value": "ecommerce"
    },
    {
      "key": "business_id",
      "value": ""
    },
    {
      "key": "product_id",
      "value": ""
    },
    {
      "key": "image_id",
      "value": ""
    },
    {
      "key": "other_business_category_id",
      "value": ""
    },
    {
      "key": "other_business_product_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Platform App (Mobile)",
      "item": [
        {
          "name": "1.2 Explore",
          "item": [
            {
              "name": "5. Products (E-commerce)",
              "description": "Requires the E-commerce plugin enabled.",
              "item": [
                {
                  "name": "Explore products",
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Authorization",
                        "value": "Bearer {{access_token}}"
                      }
                    ],
                    "url": {
                      "raw": "{{base_url}}/plugins/ecommerce/explore/products?page=1&page_size=20",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "plugins",
                        "ecommerce",
                        "explore",
                        "products"
                      ],
                      "query": [
                        {
                          "key": "page",
                          "value": "1"
                        },
                        {
                          "key": "page_size",
                          "value": "20"
                        },
                        {
                          "key": "q",
                          "value": "",
                          "description": "Optional. Matches product name, description or category name.",
                          "disabled": true
                        },
                        {
                          "key": "category_id",
                          "value": "",
                          "description": "Optional product category UUID (from Explore categories).",
                          "disabled": true
                        },
                        {
                          "key": "business_id",
                          "value": "",
                          "description": "Optional. Only products of this nearby business.",
                          "disabled": true
                        },
                        {
                          "key": "min_price",
                          "value": "",
                          "description": "Optional lowest selling price.",
                          "disabled": true
                        },
                        {
                          "key": "max_price",
                          "value": "",
                          "description": "Optional highest selling price.",
                          "disabled": true
                        },
                        {
                          "key": "sort",
                          "value": "",
                          "description": "Optional. nearest (default), newest, price_low or price_high.",
                          "disabled": true
                        },
                        {
                          "key": "in_stock_only",
                          "value": "",
                          "description": "Optional, default true. Send false to include sold-out products.",
                          "disabled": true
                        },
                        {
                          "key": "village_id",
                          "value": "",
                          "description": "Optional village UUID. Explore this village instead of your native places.",
                          "disabled": true
                        }
                      ]
                    },
                    "description": "Mobile (any signed-in user). Lists published (active) products from businesses near the caller's native places (primary + secondary, within the user's nearby radius setting) that have the E-commerce plugin enabled. Nearest business first by default. `has_native_place` is false when the user has not set a native place, so the app can prompt them. Each item carries `business` (id, name, distance_km), `currency`, `in_stock` and `available_quantity`. To buy: `POST /businesses/{business.id}/orders` with the product id and quantity."
                  }
                },
                {
                  "name": "Explore product categories",
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Authorization",
                        "value": "Bearer {{access_token}}"
                      }
                    ],
                    "url": {
                      "raw": "{{base_url}}/plugins/ecommerce/explore/categories",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "plugins",
                        "ecommerce",
                        "explore",
                        "categories"
                      ],
                      "query": [
                        {
                          "key": "village_id",
                          "value": "",
                          "description": "Optional village UUID. Explore this village instead of your native places.",
                          "disabled": true
                        }
                      ]
                    },
                    "description": "Mobile. Product categories that currently have in-stock published products near the caller, with `product_count`, for the filter chips."
                  }
                },
                {
                  "name": "Get explore product",
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Authorization",
                        "value": "Bearer {{access_token}}"
                      }
                    ],
                    "url": {
                      "raw": "{{base_url}}/plugins/ecommerce/explore/products/{{product_id}}",
                      "host": [
                        "{{base_url}}"
                      ],
                      "path": [
                        "plugins",
                        "ecommerce",
                        "explore",
                        "products",
                        "{{product_id}}"
                      ],
                      "query": [
                        {
                          "key": "village_id",
                          "value": "",
                          "description": "Optional village UUID. Explore this village instead of your native places.",
                          "disabled": true
                        }
                      ]
                    },
                    "description": "Mobile. Full detail of one published product from a nearby business. Returns 404 if the product is inactive or its business is outside the caller's native area."
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "1.5 Businesses",
          "item": [
            {
              "name": "E-commerce",
              "item": [
                {
                  "name": "0. Setup (core endpoints)",
                  "item": [
                    {
                      "name": "Import and install plugin ZIP (admin)",
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Authorization",
                            "value": "Bearer {{access_token}}"
                          }
                        ],
                        "url": {
                          "raw": "{{base_url}}/admin/plugins/import",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "admin",
                            "plugins",
                            "import"
                          ]
                        },
                        "body": {
                          "mode": "formdata",
                          "formdata": [
                            {
                              "key": "file",
                              "type": "file",
                              "src": "plugin_packages/ecommerce/ecommerce-1.2.2.zip"
                            }
                          ]
                        },
                        "description": "Extracts and installs the package; the plugin key is read from its manifest. Does not enable it."
                      }
                    },
                    {
                      "name": "Upgrade plugin ZIP (admin)",
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Authorization",
                            "value": "Bearer {{access_token}}"
                          }
                        ],
                        "url": {
                          "raw": "{{base_url}}/admin/plugins/upgrade",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "admin",
                            "plugins",
                            "upgrade"
                          ]
                        },
                        "body": {
                          "mode": "formdata",
                          "formdata": [
                            {
                              "key": "file",
                              "type": "file",
                              "src": "plugin_packages/ecommerce/ecommerce-1.2.2.zip"
                            }
                          ]
                        },
                        "description": "Use when 1.0.0 is already installed. Restart the application afterwards; routes return 503 until then."
                      }
                    },
                    {
                      "name": "Enable plugin globally (admin)",
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Authorization",
                            "value": "Bearer {{access_token}}"
                          }
                        ],
                        "url": {
                          "raw": "{{base_url}}/admin/plugins/{{plugin_key}}/enable",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "admin",
                            "plugins",
                            "{{plugin_key}}",
                            "enable"
                          ]
                        }
                      }
                    },
                    {
                      "name": "Disable plugin globally (admin)",
                      "request": {
                        "method": "POST",
                        "header": [
