                            "key": "Authorization",
                            "value": "Bearer {{access_token}}"
                          }
                        ],
                        "url": {
                          "raw": "{{base_url}}/admin/plugins/{{plugin_key}}/disable",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "admin",
                            "plugins",
                            "{{plugin_key}}",
                            "disable"
                          ]
                        }
                      }
                    },
                    {
                      "name": "Enable plugin for business",
                      "request": {
                        "method": "POST",
                        "header": [
