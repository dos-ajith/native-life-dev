                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "plugins",
                            "ecommerce",
                            "businesses",
                            "{{business_id}}",
                            "products",
                            "{{product_id}}"
                          ]
                        }
                      }
                    },
                    {
                      "name": "Update product",
                      "request": {
                        "method": "PATCH",
                        "header": [
                          {
                            "key": "Authorization",
                            "value": "Bearer {{access_token}}"
                          },
                          {
                            "key": "Content-Type",
                            "value": "application/json"
                          }
                        ],
                        "url": {
                          "raw": "{{base_url}}/plugins/ecommerce/businesses/{{business_id}}/products/{{product_id}}",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "plugins",
                            "ecommerce",
                            "businesses",
                            "{{business_id}}",
                            "products",
                            "{{product_id}}"
                          ]
                        },
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"name\": \"Cotton T-shirt (updated)\",\n  \"selling_price\": \"549.00\",\n  \"original_price\": \"699.00\",\n  \"is_bulk_promotable\": true,\n  \"is_individually_promotable\": true,\n  \"description\": \"Updated\"\n}",
                          "options": {
                            "raw": {
                              "language": "json"
                            }
                          }
                        }
                      }
                    },
