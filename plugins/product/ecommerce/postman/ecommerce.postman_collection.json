                        "url": {
                          "raw": "{{base_url}}/plugins/ecommerce/businesses/{{business_id}}/products/{{product_id}}/deactivate",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "plugins",
                            "ecommerce",
                            "businesses",
                            "{{business_id}}",
                            "products",
                            "{{product_id}}",
                            "deactivate"
                          ]
                        }
                      }
                    }
                  ]
