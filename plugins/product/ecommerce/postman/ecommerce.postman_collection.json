                        "url": {
                          "raw": "{{base_url}}/plugins/ecommerce/businesses/{{business_id}}/products?page=1&page_size=20&q=&category_id=&is_active=true",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "plugins",
                            "ecommerce",
                            "businesses",
                            "{{business_id}}",
                            "products"
                          ],
                          "query": [
                            {
                              "key": "page",
                              "value": "1"
                            },
                            {
                              "key": "page_size",
                              "value": "20"
                            },
                            {
                              "key": "q",
                              "value": ""
                            },
                            {
                              "key": "category_id",
                              "value": ""
                            },
                            {
                              "key": "is_active",
                              "value": "true"
                            }
                          ]
                        },
                        "description": "Pagination (page, page_size), search by name or SKU (q), category_id and is_active filters. Empty values are ignored by Postman if you untick them."
                      }
                    },
                    {
                      "name": "Create product",
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Authorization",
                            "value": "Bearer {{access_token}}"
                          }
                        ],
                        "url": {
                          "raw": "{{base_url}}/plugins/ecommerce/businesses/{{business_id}}/products",
                          "host": [
                            "{{base_url}}"
                          ],
                          "path": [
                            "plugins",
                            "ecommerce",
                            "businesses",
                            "{{business_id}}",
                            "products"
                          ]
                        },
                        "body": {
                          "mode": "formdata",
                          "formdata": [
                            {
                              "key": "name",
                              "value": "Cotton T-shirt",
                              "type": "text"
                            },
                            {
                              "key": "sku",
                              "value": "TSHIRT-001",
                              "type": "text"
                            },
                            {
                              "key": "selling_price",
                              "value": "499.00",
                              "type": "text",
                              "description": "Selling price"
                            },
                            {
                              "key": "original_price",
                              "value": "599.00",
                              "type": "text",
                              "description": "Original price (MRP); defaults to selling_price. Must be >= selling_price"
                            },
                            {
                              "key": "description",
                              "value": "Plain cotton tee",
                              "type": "text"
                            },
                            {
                              "key": "category_id",
                              "value": "",
                              "type": "text",
                              "disabled": true
                            },
                            {
                              "key": "is_active",
                              "value": "true",
                              "type": "text"
                            },
                            {
                              "key": "is_bulk_promotable",
                              "value": "false",
                              "type": "text",
                              "description": "Included in the business-wide bulk promotion (default false)"
                            },
                            {
                              "key": "is_individually_promotable",
                              "value": "false",
                              "type": "text",
                              "description": "Can be picked by a promoter for an individual product promotion (default false)"
                            },
                            {
                              "key": "quantity",
                              "value": "20",
                              "type": "text"
                            },
                            {
                              "key": "low_stock_threshold",
                              "value": "5",
                              "type": "text"
                            },
                            {
                              "key": "images",
                              "type": "file",
                              "src": []
                            },
                            {
                              "key": "images",
                              "type": "file",
                              "src": []
                            }
                          ]
                        },
                        "description": "Creates a product with its initial stock and optional images in one multipart request. Form fields: `name`, `sku`, `selling_price` (required); `original_price` (defaults to selling_price; 422 if lower than selling_price), `description`, `category_id`, `is_active` (default true), `is_bulk_promotable` and `is_individually_promotable` (default false), `quantity` (default 0), `low_stock_threshold`; `images` (optional file, repeat the key; JPEG, PNG or WebP, max 5MB each, up to 10 per product). Images are shown in the order sent. Errors: 409 SKU already exists; 422 invalid image or too many images."
                      }
                    },
