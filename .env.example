# Copy this file to .env and fill in real values.
# Never commit .env itself.

APP_NAME="Native Life API"
APP_ENV=local
DEBUG=true

API_V1_PREFIX=/api/v1

# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://nativelife:change-me-locally@localhost:5432/nativelife_dev

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON array of allowed origins for the web admin panel
CORS_ORIGINS=["http://localhost:3000"]

# Local directory where uploaded files (e.g. profile images) are stored
UPLOAD_DIR=uploads

# Directory scanned for business plugins (each has a plugin.toml manifest)
PLUGINS_DIR=plugins

# Maximum accepted size, in megabytes, for an admin GIS boundary ZIP upload
GIS_IMPORT_MAX_UPLOAD_MB=200

# IANA timezone used to seed the app_timezone setting when it doesn't exist yet
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# How long a promoter has to accept a delivery request before it expires.
DELIVERY_INSTANT_ACCEPT_MINUTES=30
DELIVERY_ROUTE_ACCEPT_HOURS=12
DEFAULT_STATE_LGD_CODE=32

# AI integration. Leave the relevant *_API_KEY unset to disable AI features.
# AI_PROVIDER selects which backend AIClient talks to:
#   openai -> OpenAI Responses API (set OPENAI_API_KEY, e.g. AI_MODEL=gpt-4.1-mini)
#   groq   -> Groq's OpenAI-compatible Chat Completions API (set GROQ_API_KEY,
#             e.g. AI_MODEL=llama-3.3-70b-versatile). Useful for local/dev
#             testing without OpenAI credits.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_TOOL_ITERATIONS=8
AI_MAX_RETRIES=0
# Optional (low|medium|high): lower values answer faster on reasoning models such as openai/gpt-oss-*
# AI_REASONING_EFFORT=low

OPENAI_API_KEY=replace-with-your-openai-api-key

# Get a free key at https://console.groq.com
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# WebSocket (/api/v1/ws). The connection manager is in memory, so run a single Uvicorn process.
# Seconds the client has to send its auth frame after connecting
WS_AUTH_TIMEOUT_SECONDS=10
# Seconds before a send to a client is abandoned and that connection dropped
WS_SEND_TIMEOUT_SECONDS=5
# Expected client ping interval; a connection silent for twice this long is closed
WS_PING_INTERVAL_SECONDS=25
WS_MAX_CONNECTIONS_PER_USER=5

# Email verification OTP
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Sessions. Every login returns a short-lived access token plus a refresh token
# that is rotated on each POST /auth/refresh.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Lifetime of the token returned by phone/Google verification for new users,
# used to complete registration.
REGISTRATION_TOKEN_EXPIRE_MINUTES=15

# Phone OTP sign-in. Expiry, attempts and resend cooldown reuse the OTP_* values above.
PHONE_OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
PHONE_OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# SMS provider for phone OTP: disabled | console | twilio
#   disabled -> phone OTP endpoints return 503 (default)
#   console  -> local development only: the SMS text, including the code, is
#               written to the server log. Refused at startup when APP_ENV=production.
#   twilio   -> Twilio Programmable Messaging with an API key (Console > Account >
#               API keys & tokens). Trial accounts can only text verified numbers.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=replace-with-your-twilio-account-sid
TWILIO_API_KEY_SID=replace-with-your-twilio-api-key-sid
TWILIO_API_KEY_SECRET=replace-with-your-twilio-api-key-secret
TWILIO_FROM_NUMBER=replace-with-your-twilio-sender-number-or-id
TWILIO_REQUEST_TIMEOUT_SECONDS=10

# Push notifications (see docs/push-notifications.md).
#   disabled -> no push is sent; in-app and WebSocket notifications still work (default)
#   fcm      -> Firebase Cloud Messaging. Needs the Firebase project id and the path to the
#               service account JSON key (keep that file outside git, e.g. secrets/).


FCM_REQUEST_TIMEOUT_SECONDS=10
PUSH_WORKER_THREADS=2
# Web push only (public values from Firebase > Project settings > General > Web app, and
# Cloud Messaging > Web Push certificates). Served to web clients by GET /me/devices/web-config
# so they need no hardcoded Firebase config. Leave unset if you have no web client.


PUSH_PROVIDER=fcm
FCM_PROJECT_ID=replace-with-your-firebase-project-id
FCM_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json
FCM_WEB_API_KEY=replace-with-your-firebase-web-api-key
FCM_WEB_AUTH_DOMAIN=replace-with-your-firebase-auth-domain
FCM_WEB_STORAGE_BUCKET=replace-with-your-firebase-storage-bucket
FCM_WEB_MESSAGING_SENDER_ID=replace-with-your-firebase-sender-id
FCM_WEB_APP_ID=replace-with-your-firebase-app-id
FCM_WEB_VAPID_KEY=replace-with-your-firebase-vapid-key

# Google Sign-In: JSON array of every OAuth client ID the apps request ID tokens
# for (Android, iOS, web). Leave as [] to disable Google sign-in (endpoints return 503).
GOOGLE_CLIENT_IDS=[]

# JSON array of email domains allowed to self-register, e.g. ["gmail.com"].
# Leave as [] to allow any domain.
REGISTRATION_ALLOWED_EMAIL_DOMAINS=[]

# When true, emails are recorded in the emails table as pending and never sent
# by this app — Mandrill (Mailchimp Transactional) is expected to pick up and
# deliver them externally. SMTP settings below are ignored while this is true.
MANDRILL_ENABLED=false

# SMTP configuration used to deliver verification emails. Leave SMTP_HOST unset
# to disable email delivery (verification emails will be logged as skipped).
SMTP_HOST=replace-with-your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_USE_TLS=true
MAIL_FROM_EMAIL=replace-with-your-from-address

# Optional links shown in transactional email footers. Leave unset to omit them.
SUPPORT_URL=
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
