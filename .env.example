# Copy this file to .env and fill in real values.
# Never commit .env itself.

APP_NAME="Native Life API"
APP_ENV=local
DEBUG=true

API_V1_PREFIX=/api/v1

# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://nativelife:change-me-locally@localhost:5432/nativelife_dev

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON array of allowed origins for the web admin panel
CORS_ORIGINS=["http://localhost:3000"]

# Local directory where uploaded files (e.g. profile images) are stored
UPLOAD_DIR=uploads

# Maximum accepted size, in megabytes, for an admin GIS boundary ZIP upload
GIS_IMPORT_MAX_UPLOAD_MB=200

# IANA timezone used to seed the app_timezone setting when it doesn't exist yet
DEFAULT_TIMEZONE=Asia/Kolkata
