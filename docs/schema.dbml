Ref: activity_logs.user_id >? users.id [delete: set null]
Ref: auth_identities.user_id > users.id [delete: cascade]
Ref: business_documents.business_id > businesses.id [delete: cascade]
Ref: business_plugins.business_id > businesses.id [delete: cascade]
Ref: business_plugins.plugin_id > plugins.id [delete: cascade]
Ref: business_plugins.enabled_by >? users.id [delete: set null]
Ref: business_images.business_id > businesses.id [delete: cascade]
Ref: businesses.category_id >? categories.id [delete: restrict]
Ref: businesses.escalated_by >? users.id [delete: set null]
Ref: businesses.owner_id > users.id [delete: cascade]
Ref: businesses.reviewed_by >? users.id [delete: set null]
Ref: cart_items.deal_item_id > deal_items.id [delete: cascade]
Ref: cart_items.user_id > users.id [delete: cascade]
Ref: categories.created_by >? users.id [delete: set null]
Ref: categories.parent_id >? categories.id [delete: restrict]
Ref: categories.reviewed_by >? users.id [delete: set null]
Ref: collection_posts.collection_id > collections.id [delete: cascade]
Ref: collection_posts.saved_post_id > saved_posts.id [delete: cascade]
