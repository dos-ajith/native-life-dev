Table active_tokens {
  jti uuid [pk, not null]
  expires_at timestamptz [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table activity_logs {
  user_id uuid
  action varchar(100) [not null]
  entity_type varchar(100)
  entity_id uuid
  description text
  metadata jsonb
  ip_address varchar(45)
  user_agent varchar(500)
  created_at timestamp [not null, default: `now()`]
  id uuid [pk, not null]

  indexes {
    action [name: "ix_activity_logs_action"]
    created_at [name: "ix_activity_logs_created_at"]
    (entity_type, entity_id) [name: "ix_activity_logs_entity_type_entity_id"]
    user_id [name: "ix_activity_logs_user_id"]
  }
}

Table auth_identities {
  user_id uuid [not null]
  provider auth_provider [not null]
  subject varchar(255) [not null]
  email varchar(255)
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (provider, subject) [name: "uq_auth_identities_provider_subject", unique]
    (user_id, provider) [name: "uq_auth_identities_user_id_provider", unique]
  }
}

Table business_plugins {
  business_id uuid [not null]
  plugin_id uuid [not null]
  status business_plugin_status [not null]
  enabled_by uuid
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (business_id, plugin_id) [unique, name: 'uq_business_plugins_business_id_plugin_id']
  }
}

Table business_images {
  business_id uuid [not null]
  image_url varchar(2048) [not null]
  sort_order integer [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    business_id [name: "ix_business_images_business_id"]
  }
}

Table business_documents {
  business_id uuid [not null]
  document_type varchar(100) [not null]
  file_name varchar(255) [not null]
  content_type varchar(100) [not null]
  file_size_bytes integer [not null]
  storage_path varchar(1024) [not null]
  status business_document_status [not null]
  verified_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    business_id [name: "ix_business_documents_business_id"]
  }
}

Table businesses {
  owner_id uuid [not null]
  name varchar(255) [not null]
  description text
  status business_status [not null]
  deleted_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  category_id uuid
  location geometry(Point,4326)
  verification_status business_verification_status [not null]
  reviewed_by uuid
  reviewed_at timestamp
  review_note text
  resubmission_count integer [not null, default: `0`]
  escalated_at timestamp
  escalated_by uuid
  escalation_note text

  indexes {
    category_id [name: "ix_businesses_category_id"]
    `(location::geography)` [name: "ix_businesses_location_geography"]
    owner_id [name: "ix_businesses_owner_id"]
  }
}

Table categories {
  parent_id uuid
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  description varchar(500)
  is_active boolean [not null, default: `true`]
  sort_order integer [not null, default: `0`]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  status category_status [not null]
  created_by uuid
  reviewed_by uuid
  reviewed_at timestamp
  review_note text

  indexes {
    (parent_id, `lower((name)::text)`) [name: "uq_categories_parent_id_name", unique]
    `lower((name)::text)` [name: "uq_categories_root_name", unique]
  }
}

Table chat_conversations {
  lower_user_id uuid [not null]
  higher_user_id uuid [not null]
  last_message_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (lower_user_id, higher_user_id) [unique]
    higher_user_id [name: "ix_chat_conversations_higher_user_id"]
  }
}

Table collection_posts {
  collection_id uuid [not null]
  saved_post_id uuid [not null]
  created_at timestamp [not null, default: `now()`]
  id uuid [pk, not null]

  indexes {
    (collection_id, saved_post_id) [unique]
    collection_id [name: "ix_collection_posts_collection_id"]
    saved_post_id [name: "ix_collection_posts_saved_post_id"]
  }
}

Table collections {
  user_id uuid [not null]
  name varchar(100) [not null]
  description varchar(500)
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    user_id [name: "ix_collections_user_id"]
  }
}

Table communities {
  owner_id uuid [not null]
  village_id uuid
  name varchar(150) [not null]
  description text
  image_url varchar(2048)
  auto_approve_members boolean [not null, default: `false`]
  max_members integer
  members_count integer [not null, default: `0`]
  status community_status [not null]
  reviewed_by uuid
  reviewed_at timestamp
  review_note text
  resubmission_count integer [not null, default: `0`]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    owner_id [name: "ix_communities_owner_id"]
    status [name: "ix_communities_status"]
    village_id [name: "ix_communities_village_id"]
    `lower(name)` [name: "uq_communities_name_active", unique]
  }
}

Table community_messages {
  community_id uuid [not null]
  sender_id uuid [not null]
  content text [not null]
  created_at timestamp [not null, default: `now()`]
  id uuid [pk, not null]
  reply_to_id uuid

  indexes {
    (community_id, created_at) [name: "ix_community_messages_community_id_created_at"]
    reply_to_id [name: "ix_community_messages_reply_to_id"]
  }
}

Table community_poll_options {
  poll_id uuid [not null]
  text varchar(200) [not null]
  position integer [not null]
  votes_count integer [not null, default: `0`]
  id uuid [pk, not null]

  indexes {
    poll_id [name: "ix_community_poll_options_poll_id"]
  }
}

Table community_poll_votes {
  poll_id uuid [not null]
  option_id uuid [not null]
  user_id uuid [not null]
  created_at timestamp [not null, default: `now()`]
  id uuid [pk, not null]

  indexes {
    (poll_id, user_id) [name: "ix_community_poll_votes_poll_id_user_id"]
    (option_id, user_id) [name: "uq_community_poll_votes_option_id_user_id", unique]
  }
}

Table community_polls {
  community_id uuid [not null]
  author_id uuid [not null]
  question varchar(500) [not null]
  allows_multiple boolean [not null, default: `false`]
  show_results_before_vote boolean [not null, default: `false`]
  ends_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (community_id, created_at) [name: "ix_community_polls_community_id_created_at"]
  }
}

Table community_members {
  community_id uuid [not null]
  user_id uuid [not null]
  status community_member_status [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  last_read_at timestamp

  indexes {
    user_id [name: "ix_community_members_user_id"]
    (community_id, user_id) [name: "uq_community_members_community_user", unique]
  }
}

Table email_verification_otps {
  user_id uuid [not null]
  otp_hash varchar(255) [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  attempts integer [not null, default: `0`]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    user_id [name: "ix_email_verification_otps_user_id"]
  }
}

Table emails {
  user_id uuid
  to_email varchar(255) [not null]
  from_email varchar(255)
  subject varchar(255) [not null]
  email_type email_type [not null]
  provider varchar(50) [not null]
  provider_message_id varchar(255)
  status email_status [not null]
  error_code varchar(100)
  error_message text
  metadata jsonb
  sent_at timestamp
  delivered_at timestamp
  failed_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  text_body text [not null]
  html_body text [not null]

  indexes {
    created_at [name: "ix_emails_created_at"]
    email_type [name: "ix_emails_email_type"]
    provider_message_id [name: "ix_emails_provider_message_id", unique]
    status [name: "ix_emails_status"]
    user_id [name: "ix_emails_user_id"]
  }
}

Table gis_districts {
  state_id uuid [not null]
  lgd_code varchar(10) [not null, unique]
  name varchar(150) [not null]
  geom geometry(MultiPolygon,4326) [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    geom [name: "ix_gis_districts_geom"]
    state_id [name: "ix_gis_districts_state_id"]
  }
}

Table gis_states {
  lgd_code varchar(10) [not null, unique]
  name varchar(150) [not null]
  geom geometry(MultiPolygon,4326) [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    geom [name: "ix_gis_states_geom"]
  }
}

Table gis_taluks {
  district_id uuid [not null]
  lgd_code varchar(10) [not null, unique]
  name varchar(150) [not null]
  geom geometry(MultiPolygon,4326) [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    district_id [name: "ix_gis_taluks_district_id"]
    geom [name: "ix_gis_taluks_geom"]
  }
}

Table gis_villages {
  taluk_id uuid [not null]
  lgd_code varchar(10) [not null, unique]
  name varchar(150) [not null]
  tag_name varchar(150)
  image_url varchar(2048)
  native_admin_id uuid [unique]
  geom geometry(MultiPolygon,4326) [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    taluk_id [name: "ix_gis_villages_taluk_id"]
    geom [name: "ix_gis_villages_geom", type: gist]
  }
}

Table deals {
  created_by uuid [not null]
  business_id uuid
  category_id uuid [not null]
  name varchar(255) [not null]
  description text
  status deal_status [not null]
  max_acceptances smallint [not null, default: `1`]
  accepted_count smallint [not null, default: `0`]
  min_joiners integer
  joined_count integer [not null, default: `0`]
  pickup_location varchar(500)
  delivery_details text
  delivery_options varchar(20)[] [not null, default: `ARRAY['instant','route','self_pickup']::varchar[]`]
  starts_at timestamp
  valid_until timestamp
  submitted_at timestamp
  acceptance_deadline timestamp
  published_at timestamp
  deleted_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    acceptance_deadline [name: "ix_deals_acceptance_deadline", note: "WHERE status = 'pending_acceptance'"]
    business_id [name: "ix_deals_business_id"]
    category_id [name: "ix_deals_category_id"]
    created_by [name: "ix_deals_created_by"]
    published_at [name: "ix_deals_published_at", note: "WHERE status = 'published' AND deleted_at IS NULL"]
  }

  Note: 'CHECK max_acceptances >= 1; CHECK accepted_count >= 0 AND accepted_count <= max_acceptances'
}

Table deal_natives {
  deal_id uuid [not null]
  village_id uuid [not null]
  is_primary boolean [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (deal_id, village_id) [name: "uq_deal_natives_deal_id_village_id", unique]
    deal_id [name: "uq_deal_natives_one_primary", unique, note: "WHERE is_primary"]
    (village_id, deal_id) [name: "ix_deal_natives_village_id_deal_id"]
  }
}

Table deal_images {
  deal_id uuid [not null]
  storage_path varchar(1024) [not null]
  content_type varchar(100) [not null]
  file_size_bytes integer [not null]
  is_thumbnail boolean [not null]
  sort_order integer [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    deal_id [name: "ix_deal_images_deal_id"]
    deal_id [name: "uq_deal_images_one_thumbnail", unique, note: "WHERE is_thumbnail"]
  }
}

Table deal_items {
  deal_id uuid [not null]
  name varchar(255) [not null]
  description text
  unit varchar(50)
  quantity integer
  original_price numeric(12,2)
  deal_price numeric(12,2)
  image_id uuid
  sort_order integer [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  product_id uuid

  indexes {
    deal_id [name: "ix_deal_items_deal_id"]
  }

  Note: 'CHECK quantity IS NULL OR quantity > 0; CHECK prices >= 0; CHECK deal_price <= original_price when both set; product_id references a commerce plugin product (no FK)'
}

Table orders {
  order_number varchar(40) [not null, unique]
  deal_id uuid
  business_id uuid
  customer_id uuid [not null]
  status order_status [not null]
  customer_name varchar(150) [not null]
  customer_phone varchar(30)
  shipping_address text
  shipping_location geometry(Point,4326)
  shipping_village_id uuid
  shipping_address_id uuid
  notes text
  currency varchar(3) [not null]
  total_amount numeric(14,2) [not null]
  cancellation_reason varchar(500)
  cancelled_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  order_type order_type [not null]
  promoter_id uuid
  delivery_option delivery_option
  delivery_fee numeric(14,2) [not null, default: `0`]
  expected_delivery_date date
  expected_delivery_from time
  expected_delivery_to time
  payment_method payment_method [not null, default: `'cash_on_delivery'`]
  tax_amount numeric(14,2) [not null, default: `0`]

  indexes {
    business_id [name: "ix_orders_business_id"]
    customer_id [name: "ix_orders_customer_id"]
  }

  Note: 'CHECK (order_type = deal) = (deal_id IS NOT NULL): deal orders reference a deal, direct orders do not. CHECK business_id IS NOT NULL OR order_type = deal: only deal orders may have no business (deals sold by an individual)'
}

Table order_items {
  order_id uuid [not null]
  deal_item_id uuid
  product_id uuid
  product_name varchar(255) [not null]
  unit_price numeric(12,2) [not null]
  quantity integer [not null]
  line_total numeric(14,2) [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  tax_percent numeric(5,2) [not null, default: `0`]
  tax_amount numeric(14,2) [not null, default: `0`]

  indexes {
    deal_item_id [name: "ix_order_items_deal_item_id"]
  }

  Note: 'product_id references a commerce plugin product (no FK); null for manual items of deals sold by an individual'
}

Table deal_invitations {
  deal_id uuid [not null]
  user_id uuid [not null]
  role_id uuid [not null]
  status deal_invitation_status [not null]
  notified_at timestamp
  decided_at timestamp
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (deal_id, user_id) [name: "uq_deal_invitations_deal_id_user_id", unique]
    (user_id, status) [name: "ix_deal_invitations_user_id_status"]
  }
}

Table deal_participants {
  deal_id uuid [not null]
  user_id uuid [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (deal_id, user_id) [name: "uq_deal_participants_deal_id_user_id", unique]
    user_id [name: "ix_deal_participants_user_id"]
  }
}

Table cart_items {
  user_id uuid [not null]
  deal_item_id uuid [not null]
  quantity integer [not null]
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, deal_item_id) [name: "uq_cart_items_user_id_deal_item_id", unique]
  }

  Note: 'CHECK quantity > 0'
}

Table delivery_settings {
  user_id uuid [not null]
  working_days smallint[] [not null]
  route_start_time time [not null]
  route_end_time time [not null]
  instant_fee numeric(12,2)
  route_fee numeric(12,2)
  id uuid [pk, not null]
  created_at timestamp [not null, default: `now()`]
